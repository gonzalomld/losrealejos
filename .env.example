# Persistencia del gestor (Postgres en Unión Europea). Nunca commitear valores reales.
# En Vercel se configuran como variables de entorno del proyecto (Production).
# Sin estas dos variables el gestor usa el comportamiento de reserva:
# fichero local en desarrollo, modo consulta en despliegue.

# URL del proyecto Supabase (región europea, p. ej. https://xyzcompany.supabase.co)
SUPABASE_URL=

# Clave de servicio (service_role). SOLO SERVIDOR: jamás exponer con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
